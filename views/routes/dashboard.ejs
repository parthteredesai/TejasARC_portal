<% layout("/layouts/boilerplate") %>
<body>
  <div class="dashContainer">
    <div class="sec1">

      <div class="sub-sec1x">
  <h3>Last Updated</h3>

  <%
    const lastEntry = allData[allData.length - 1];
    const ts = new Date(lastEntry.insight.timestamp);

    const date = ts.toLocaleDateString();   // e.g. 26/12/2025
    const time = ts.toLocaleTimeString();   // e.g. 5:32:18 PM
  %>

  <h5>Date : <%= date %></h5>
  <h5>Time : <%= time %></h5>
</div>


      <div class="sub-sec1">
        <h4 class="efficiencytext"> Live Efficiency </h4>
        <% 
          const efficiencyValue = allData[allData.length - 1].insight.live_diagnosis.efficiency_pct; 
          const filledAngle = (efficiencyValue / 100) * 360; 
        %>
        <div class="efficiency-container">
            <span class="efficiency-value"><%= efficiencyValue %>%</span>
            <div class="progress-circle" 
                 style="--filled-angle: <%= filledAngle %>deg;">
            </div>
        </div>
      </div>

      <div class="sub-sec1">
        <h4 class="healthtext"> Today's Predicted Efficiency</h4>
        <% 
          const healthValue = allData[allData.length - 1].insight.weather_benchmark.efficiency_score; 
          const healthfilledAngle = ((healthValue*100) / 100) * 360; 
        %>
        <div class="health-container">
            <span class="health-value"><%= healthValue*100 %>%</span>
            <div class="progress-circle-health" 
                 style="--filled-angle: <%= healthfilledAngle %>deg;">
            </div>
        </div>
      </div>


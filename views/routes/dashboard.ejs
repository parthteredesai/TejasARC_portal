          y="205"
          width="8"
          height="10"
          fill="url(#pinGradient)"
          rx="2"
        ></rect>
        <rect
          x="322"
          y="225"
          width="8"
          height="10"
          fill="url(#pinGradient)"
          rx="2"
        ></rect>
        <rect
          x="322"
          y="245"
          width="8"
          height="10"
          fill="url(#pinGradient)"
          rx="2"
        ></rect>
        <rect
          x="322"
          y="265"
          width="8"
          height="10"
          fill="url(#pinGradient)"
          rx="2"
        ></rect>
      </g>

      <g>
        <rect
          x="470"
          y="205"
          width="8"
          height="10"
          fill="url(#pinGradient)"
          rx="2"
        ></rect>
        <rect
          x="470"
          y="225"
          width="8"
          height="10"
          fill="url(#pinGradient)"
          rx="2"
        ></rect>
        <rect
          x="470"
          y="245"
          width="8"
          height="10"
          fill="url(#pinGradient)"
          rx="2"
        ></rect>
        <rect
          x="470"
          y="265"
          width="8"
          height="10"
          fill="url(#pinGradient)"
          rx="2"
        ></rect>
      </g>

      <text
        x="400"
        y="240"
        font-family="Arial, sans-serif"
        font-size="22"
        fill="url(#textGradient)"
        text-anchor="middle"
        alignment-baseline="middle"
      >
        MYOSA
      </text>

      <circle cx="100" cy="100" r="5" fill="black"></circle>
      <circle cx="80" cy="180" r="5" fill="black"></circle>
      <circle cx="60" cy="260" r="5" fill="black"></circle>
      <circle cx="100" cy="350" r="5" fill="black"></circle>

      <circle cx="700" cy="90" r="5" fill="black"></circle>
      <circle cx="740" cy="160" r="5" fill="black"></circle>
      <circle cx="720" cy="250" r="5" fill="black"></circle>
      <circle cx="680" cy="340" r="5" fill="black"></circle>
    </svg>
  </div>
</div>

        </div>
        <div class="sub-sec2-1x2">
          
            <div class="weather11">
              <div class="weather-title">
                <p> Weather Now :</p>
              </div>
              <% if (weather) { %>
                <div class="weather-item"> <i class="fa-solid fa-location-dot"></i><b> City: <%= weather.city %> </b></div>
                <div class="weather-item"> <i class="fa-solid fa-globe"></i> Longitude: <%= weather.city_lon %></div>
                <div class="weather-item"> <i class="fa-solid fa-globe"></i> Latitude: <%= weather.city_lat %></div>
                <div class="weather-item"> <i class="fa-solid fa-water"></i> Sea Level: <%= weather.sealvl %></div>
                <div class="weather-item"> <i class="fa-solid fa-landmark"></i></i> Ground Level: <%= weather.gndlvl %></div>
              <% } else { %>
                <div class="weather-item">Weather data not available</div>
              <% } %>  
            </div>
            <div class="weather12">
                
              <% if (weather) { %>
                <p> <%= weather.condition %> </p>
                <div class="weather-item"> <i class="fa-solid fa-eye"></i> Visibility : <%= weather.visibility %></div>
                <div class="weather-item"> <i class="fa-solid fa-temperature-half"></i> Temperature: <%= weather.temp %>&#8451 </div>
                <div class="weather-item"> <i class="fa-solid fa-smog"></i> Humidity : <%= weather.humidity %>% </div>
                <div class="weather-item"> <i class="fa-solid fa-smog"></i> Pressure : <%= weather.pressure %> hPa</div>
                <div class="weather-item"> <i class="fa-solid fa-wind"></i> Wind: <%= weather.wind %> m/s</div>
              <% } else { %>
                <div class="weather-item">Weather data not available</div>
              <% } %> 
            </div>
          
             
        </div>
      </div>
      <div class="sub-sec2-2">
        
        <div class="sub-sec2-2x"> 

          <!-- /////////////  Bus Voltage Graph code logic   ////////////// -->
           <div class="busVoltagetitle">
             <h4> Bus Voltage Chart (Last 20 Records)</h4>
          </div> 

          <div class="busVoltageChart">
            <canvas id="busVoltageChart"></canvas>
          </div>

          <script>
            async function loadSolarData() {
            const res = await fetch("/api/solar"); 
            const data = await res.json();

            const N = 20;
            const recent = data.slice(-N).reverse();

            const labels = recent.map(d => 
                new Date(d.timestamp).toLocaleTimeString()
            );

            const voltage = recent.map(d => d.sensors.bus_voltage);

            new Chart(document.getElementById("busVoltageChart"), {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: "Bus Voltage (V)",
                        data: voltage,
                        borderWidth: 2,
                        borderColor: "#0d4e87",
                        backgroundColor: "rgba(30,136,229,0.15)",
                        tension: 0.3,
                        fill: true
                    }]
                },
                options: {
                        responsive: true,
                        maintainAspectRatio: false 
                }
            });
        }

        loadSolarData();
        </script>
        </div>
        <!-- ////////////////////////////////////////////////////////// -->
         <div class="sub-sec2-2x2">

          <div class="shuntVoltagetitle">
            <h4> Shunt Voltage Chart (Last 20 Records)</h4>
          </div>

          <div class="shuntVoltageChart">
            <canvas id="shuntVoltageChart"></canvas>
          </div>
          
          <script>
            async function loadSolarData2() {
            const res = await fetch("/api/solar"); 
            const data = await res.json();

            const N = 20;
            const recent = data.slice(-N).reverse();

            const labels = recent.map(d => 
                new Date(d.timestamp).toLocaleTimeString()
            );

            const sh_voltage = recent.map(d => d.sensors.shunt_voltage);

            new Chart(document.getElementById("shuntVoltageChart"), {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: "Shunt Voltage (V)",
                        data: sh_voltage,
                        borderWidth: 2,
                        borderColor: "#0f5ff4",
                        backgroundColor: "rgba(15, 95, 244,0.25)",
                        tension: 0.3,
                        fill: true

                    }]
                },
                options: {
                        responsive: true,
                        maintainAspectRatio: false 
                        
                }
            });
        }

        loadSolarData2();
        </script>
         </div>
         <!-- ----------------current graph------------------ -->
         <div class="sub-sec2-2x3"> 
          <div class="currentTitle">
             <h4> Current Chart (Last 20 Records)</h4>
          </div>
           
          <div class="currentChart">
            <canvas id="currentChart"></canvas>
          </div>
          
          <script>
            async function loadSolarData3() {
            const res = await fetch("/api/solar"); 
            const data = await res.json();

            const N = 20;
            const recent = data.slice(-N).reverse();

            const labels = recent.map(d => 
                new Date(d.timestamp).toLocaleTimeString()
            );

            const current = recent.map(d => d.sensors.current);

            new Chart(document.getElementById("currentChart"), {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: "Current (A)",
                        data: current,
                        borderWidth: 2,
                        borderColor: "#ffac81",
                        backgroundColor: "rgba(255, 239, 99,0.45)",
                        tension: 0.3,
                        fill: true

                    }]
                },
                options: {
                        responsive: true,
                        maintainAspectRatio: false 
                        
                }
            });
        }

        loadSolarData3();
        </script>

         </div>
         <div class="sub-sec2-2x4">

          <div class="powertitle">
             <h4> Power Chart (Last 20 Records)</h4>
          </div>
           
          <div class="powerChart">
            <canvas id="powerChart"></canvas>
          </div>

          <script>
            async function loadSolarData4() {
            const res = await fetch("/api/solar"); 
            const data = await res.json();

            const N = 20;
            const recent = data.slice(-N).reverse();

            const labels = recent.map(d => 
                new Date(d.timestamp).toLocaleTimeString()
            );

            const power = recent.map(d => d.sensors.power);

            new Chart(document.getElementById("powerChart"), {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: "Power (KW)",
                        data: power,
                        borderWidth: 2,
                        borderColor: "#ff8800",
                        backgroundColor: "rgba(255, 136, 0,0.25)",
                        tension: 0.3,
                        fill: true

                    }]
                },
                options: {
                        responsive: true,
                        maintainAspectRatio: false 
                        

<% layout("/layouts/boilerplate") %>
<body>
  <div class="dashContainer">
    <div class="sec1">
      <div class="sub-sec1">
        <h4 class="healthtext"> Panel Health Indicator</h4>
        <% 
          const healthValue = allData[allData.length - 1].ai_output.panel_health_score; 
          const healthfilledAngle = (healthValue / 100) * 360; 
        %>
        <div class="health-container">
            <span class="health-value"><%= healthValue %>%</span>
            <div class="progress-circle-health" 
                 style="--filled-angle: <%= healthfilledAngle %>deg;">
            </div>
        </div>
      </div>

      <div class="sub-sec1">
        <h4 class="efficiencytext"> Efficiency Tracker</h4>
        <% 
          const efficiencyValue = allData[allData.length - 1].ai_output.predicted_efficiency; 
          const filledAngle = (efficiencyValue / 100) * 360; 
        %>
        <div class="efficiency-container">
            <span class="efficiency-value"><%= efficiencyValue %>%</span>
            <div class="progress-circle" 
                 style="--filled-angle: <%= filledAngle %>deg;">
            </div>
        </div>
      </div>

      <div class="sub-sec1">
        <% 
          const statusString = allData[allData.length - 1].ai_output.status; 
        %>
        <h4 class="status">Panel status: <%= statusString %></h4>
         <div class="solar-panel-container">
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
         </div>
       </div>
    </div>
    <div class="sec2">
      <p class="dashIntro">Welcome to Dashboard</p>
      <div class="sub-sec2-1">
        <div class="sub-sec2-1x1">1x</div>
        <div class="sub-sec2-1x1">2x</div>
        <div class="sub-sec2-1x2">
          
            <div class="weather1">
              <div class="weather-title">
                <p>Weather Now :</p>
              </div>
              <% if (weather) { %>
                <div class="weather-item"> <i class="fa-solid fa-location-dot"></i> City: <%= weather.city %></div>
                <div class="weather-item"> <i class="fa-solid fa-globe"></i> City_longitude: <%= weather.city_lon %></div>
                <div class="weather-item"> <i class="fa-solid fa-globe"></i> City_lattitude: <%= weather.city_lat %></div>
                <div class="weather-item"> <i class="fa-solid fa-water"></i> City_Sea_Level: <%= weather.sealvl %></div>
                <div class="weather-item"> <i class="fa-solid fa-landmark"></i></i> City_Ground_Level: <%= weather.gndlvl %></div>
              <% } else { %>
                <div class="weather-item">Weather data not available</div>
              <% } %>  
            </div>
            <div class="weather1">2</div>
          
             
        </div>
      </div>
      <div class="sub-sec2-2">
        
        <div class="sub-sec2-2x"> 

          <!-- /////////////  Bus Voltage Graph code logic   ////////////// -->
           <div class="busVoltagetitle">
             <h4> Bus Voltage Chart (Last 20 Records)</h4>
          </div> 

          <div class="busVoltageChart">
            <canvas id="busVoltageChart"></canvas>
          </div>

          <script>
            async function loadSolarData() {
            const res = await fetch("/api/solar"); 
            const data = await res.json();

            const N = 20;
            const recent = data.slice(-N).reverse();

            const labels = recent.map(d => 
                new Date(d.timestamp).toLocaleTimeString()
            );

            const voltage = recent.map(d => d.sensors.bus_voltage);

            new Chart(document.getElementById("busVoltageChart"), {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: "Bus Voltage (V)",
                        data: voltage,
                        borderWidth: 2,
                        borderColor: "blue",
                        backgroundColor: "rgba(30,136,229,0.15)",
                        tension: 0.3,
                        fill: true
                    }]
                },
                options: {
                        responsive: true,
                        maintainAspectRatio: false 
                }
            });
        }

        loadSolarData();
        </script>
        </div>
        <!-- ////////////////////////////////////////////////////////// -->
         <div class="sub-sec2-2x2">

          <div class="shuntVoltagetitle">
            <h4> Shunt Voltage Chart (Last 20 Records)</h4>
          </div>

          <div class="shuntVoltageChart">
            <canvas id="shuntVoltageChart"></canvas>
          </div>
          
          <script>
            async function loadSolarData2() {
            const res = await fetch("/api/solar"); 
            const data = await res.json();

            const N = 20;
            const recent = data.slice(-N).reverse();

            const labels = recent.map(d => 
                new Date(d.timestamp).toLocaleTimeString()
            );

            const sh_voltage = recent.map(d => d.sensors.shunt_voltage);

            new Chart(document.getElementById("shuntVoltageChart"), {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: "Shunt Voltage (V)",
                        data: sh_voltage,
                        borderWidth: 2,
                        borderColor: "#c62828",
                        backgroundColor: "rgba(245, 217, 152,0.45)",
                        tension: 0.3,
                        fill: true

                    }]
                },
                options: {
                        responsive: true,
                        maintainAspectRatio: false 
                        
                }
            });
        }

        loadSolarData2();
        </script>
         </div>
      </div>
      <div class="sub-sec2-3">
        3
        <div class="sub-sec2-3x">sensor data breakdown</div>
      </div>
    </div>
  </div>
</body>

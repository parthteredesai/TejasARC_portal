           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
         </div>
       </div>
    </div>
    <div class="sec2">
      <p class="dashIntro">Welcome to Dashboard <i class="fa-solid fa-chart-simple"></i></p>
      <div class="sub-sec2-1">
        <div class="sub-sec2-1x1 power">
          <% 
          const powerGenerated = allData[allData.length - 1].insight.live_diagnosis.actual_power; 
          const powerGeneratedPred = allData[allData.length - 1].insight.live_diagnosis.predicted_power; 
          %>
          <h4 class="powerGeneratedtitle">Power Generation By Solar Panel: </h4>
          <h4 class="powerGeneratedvalue">Actual :<%= powerGenerated %> W</h4>
          <h4 class="powerGeneratedvalue">Predicted :<%= powerGeneratedPred %> W</h4>
            

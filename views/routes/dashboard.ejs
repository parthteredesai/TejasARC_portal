        </div>
        <div class="sub-sec2-1x2">
          
            <div class="weather11">
              <div class="weather-title">
                <p> Weather Now </p>
              </div>
              <% if (weather) { %>
                <div class="weather-item"> <i class="fa-solid fa-location-dot"></i><b> City: <%= weather.city %> </b></div>
                <div class="weather-item"> <i class="fa-solid fa-globe"></i> Longitude: <%= weather.city_lon %></div>
                <div class="weather-item"> <i class="fa-solid fa-globe"></i> Latitude: <%= weather.city_lat %></div>
                <div class="weather-item"> <i class="fa-solid fa-water"></i> Sea Level: <%= weather.sealvl %></div>
                <div class="weather-item"> <i class="fa-solid fa-landmark"></i></i> Ground Level: <%= weather.gndlvl %></div>
              <% } else { %>
                <div class="weather-item">Weather data not available</div>
              <% } %>  
            </div>
            <div class="weather12">
                
              <% if (weather) { %>
                <p> <%= weather.condition %> </p>
                <div class="weather-item"> <i class="fa-solid fa-eye"></i> Visibility : <%= weather.visibility %></div>
                <div class="weather-item"> <i class="fa-solid fa-temperature-half"></i> Temperature: <%= weather.temp %>&#8451 </div>
                <div class="weather-item"> <i class="fa-solid fa-smog"></i> Humidity : <%= weather.humidity %>% </div>
                <div class="weather-item"> <i class="fa-solid fa-smog"></i> Pressure : <%= weather.pressure %> hPa</div>
                <div class="weather-item"> <i class="fa-solid fa-wind"></i> Wind: <%= weather.wind %> m/s</div>
              <% } else { %>
                <div class="weather-item">Weather data not available</div>
              <% } %> 
            </div>
          
             
        </div>
      </div>

      <div class="sub-sec2-2">
        
        <div class="sub-sec2-2x"> 
          <!-- /////////////  Bus Voltage Graph code logic   ////////////// -->
           <div class="efficiencytitle">
             <p> <i class="fa-solid fa-chart-line"></i> Efficiency Graph</p>
          </div> 

          <div class="efficiencyChart">
            <canvas id="efficiencyChart"></canvas>
          </div>

          <script>
            async function loadSolarData() {
            const res = await fetch("/api/solar"); 
            const data = await res.json();

            const N = 20;
            const recent = data.slice(N).reverse();

            const labels = recent.map(d => new Date(d.insight.timestamp).toLocaleTimeString());

            const efficiency = recent.map(d => d.insight.live_diagnosis.efficiency_pct);

            new Chart(document.getElementById("efficiencyChart"), {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: "Efficiency",
                        data: efficiency,
                        borderWidth: 2,
                        borderColor: "#0d4e87",
                        backgroundColor: "rgba(30,136,229,0.15)",
                        tension: 0.3,
                        fill: true
                    }]
                },
                options: {
                        responsive: true,
                        maintainAspectRatio: false 
                }
            });
        }

        loadSolarData();
        </script>
        </div>
        <!-- ////////////////////////////////////////////////////////// -->
         <div class="sub-sec2-2x2">

          <div class="predictiontitle">
            <p><i class="fa-solid fa-chart-column"></i> Efficiency Predictions<p>
          </div>

          <div class="predictionChart">
            <canvas id="predictionChart"></canvas>
          </div>
          
          <script>
async function loadForecastEfficiency() {
  const res = await fetch("/api/solar");
  const data = await res.json();

  // 1️⃣ Get latest document
  const latest = data[data.length - 1];

  // 2️⃣ Extract five day forecast
  const forecast = latest.insight.five_day_forecast;

  // 3️⃣ Labels & values
  const labels = forecast.map(d => d.day);
  const efficiency = forecast.map(d => d.efficiency);

  new Chart(document.getElementById("predictionChart"), {
    type: "bar",   // 🔁 changed to bar
    data: {
      labels: labels,
      datasets: [{
        label: "Efficiency (%)  5 Day Forecast",
        data: efficiency,

        backgroundColor: "rgba(46, 204, 113, 0.6)",
        borderColor: "#2ecc71",
        borderWidth: 1,
        borderRadius: 6,     // rounded bars
        barPercentage: 0.6,
        categoryPercentage: 0.7
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        y: {
          beginAtZero: true,
          max: 100,
          title: {
            display: true,
            text: "Efficiency (%)"
          }
        }
      }
    }
  });
}

loadForecastEfficiency();
</script>


         </div>
         <div class="sub-sec2-2x3">
          <% 
          const health_score_str = allData[allData.length - 1].insight.live_diagnosis.health_score; 
          const benchmark = allData[allData.length - 1].insight.weather_benchmark.benchmark_pct; 
          const temp = allData[allData.length - 1].insight.weather_benchmark.temp; 
          const fivedayeff = allData[allData.length - 1].insight.five_day_forecast[0].efficiency; 
          const fivedaymeta = allData[allData.length - 1].insight.five_day_forecast[0].meta; 
          %>
          <ul>
            <li> <b>Panel Health :</b> <%= health_score_str %></li>
            <li> <b>Benchmark % :</b> <%= benchmark %> %</li>
            <li> <b>Temperature :</b> <%= temp %>&#8451</li>
            <br>
            <b>Tomorrow's Predictions: </b>
            <li> <b>Efficiency :</b> <%= fivedayeff %></li>
            <li><%= fivedaymeta %></li>
          </ul>
         </div>
      </div>

      <div class="sub-sec2-3">

        <div class="sub-sec2-3cover">
          <h2> <i class="fa-solid fa-database"></i> Sensor Data :</h2>
        <div class="sub-sec2-3x1">
          <div class="sensorDatalist">
             <% 
          const lux = espdata.lux; 
          const r = espdata.r;  
          const g = espdata.g; 
          const b = espdata.b; 
          const v = espdata.v; 
          const ma = espdata.ma; 
          const vib = espdata.vib; 
          const prox = espdata.prox; 
          const atp = espdata.atp; 
          const ptp = espdata.ptp; 
          const hum = espdata.hum; 
          const tlt = espdata.tlt; 
          const dst = espdata.dst; 
          const tsp = new Date(espdata.ts);

    const espdate = tsp.toLocaleDateString();   // e.g. 26/12/2025
    const esptime = tsp.toLocaleTimeString();   // e.g. 5:32:18 PM
          %>
          <ul>
              <li><b> Date & Time :</b> <%= espdate %> <%= esptime %> </li>
              <li><b> Light Irradiance :</b> <%= lux %> lux </li>
              <li><b> R :</b> <%= r %> <b> G :</b> <%= g %> <b> B :</b> <%= b %></li>
              <li><b> Voltage :</b> <%= v %> V <b>, Current :</b> <%= ma %> mA</li>
              <li><b> Vibration :</b> <%= vib %> mm/s </li>
              <li><b> Proximity :</b> <%= prox %> </li>
              <li><b> Ambient temp. :</b> <%= atp %>&#8451 </li>
              <li><b> Panel temp. :</b> <%= ptp %>&#8451 </li>
              <li><b> Humidity :</b> <%= hum %> % </li>
              <li><b> Tilt :</b> <%= tlt %>&deg degrees </li>
              <li><b> Dust :</b> <%= dst %> &#956g/m<sup>3</sup> </li>
            </ul>
          </div>
        </div>
        </div>
        <div class="sub-sec2-3x2">
          <h2> <i class="fa-solid fa-triangle-exclamation"></i> Alerts & Forecast :</h2>
          <% 
          const rootcause = allData[allData.length - 1].insight.live_diagnosis.root_cause; 
          const contributingFactors = allData[allData.length - 1].insight.weather_benchmark.recommendation; 
          const recommendations = allData[allData.length - 1].insight.expert_recommendation; 
          const visibility_km = allData[allData.length - 1].insight.weather_benchmark.weather_snapshot.visibility_km; 
          const clouds = allData[allData.length - 1].insight.weather_benchmark.weather_snapshot.clouds;
          const wind_cooling_factor = allData[allData.length - 1].insight.weather_benchmark.weather_snapshot.wind_cooling_factor;
          %>
          <div class="alert1">
            <ul>
              <li><b> Root Cause :</b> <%= rootcause %> </li>
              <% if (contributingFactors && contributingFactors.length > 0) { %>
                 <li> <b>Contributing Factors :</b> <%= contributingFactors %> </li>
              <% } else { %> 
                 <li><b> Contributing Factors :</b> None </li>
              <% } %>
              <li><b> Recommendations :</b> <%= recommendations %> </li>
            </ul>
          </div>
          <div class="alert2">
            <ul>
              <li><b> Visibility :</b> <%= visibility_km %> Km </li>
              <li><b> Clouds :</b> <%= clouds %> </li>
              <li><b> Wind Cooling Factor :</b> <%= wind_cooling_factor %> </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>

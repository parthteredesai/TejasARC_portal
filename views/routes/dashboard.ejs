</div>

        </div>
        <div class="sub-sec2-1x2">
          
            <div class="weather11">
              <div class="weather-title">
                <p> Weather Now :</p>
              </div>
              <% if (weather) { %>
                <div class="weather-item"> <i class="fa-solid fa-location-dot"></i><b> City: <%= weather.city %> </b></div>
                <div class="weather-item"> <i class="fa-solid fa-globe"></i> Longitude: <%= weather.city_lon %></div>
                <div class="weather-item"> <i class="fa-solid fa-globe"></i> Latitude: <%= weather.city_lat %></div>
                <div class="weather-item"> <i class="fa-solid fa-water"></i> Sea Level: <%= weather.sealvl %></div>
                <div class="weather-item"> <i class="fa-solid fa-landmark"></i></i> Ground Level: <%= weather.gndlvl %></div>
              <% } else { %>
                <div class="weather-item">Weather data not available</div>
              <% } %>  
            </div>
            <div class="weather12">
                
              <% if (weather) { %>
                <p> <%= weather.condition %> </p>
                <div class="weather-item"> <i class="fa-solid fa-eye"></i> Visibility : <%= weather.visibility %></div>
                <div class="weather-item"> <i class="fa-solid fa-temperature-half"></i> Temperature: <%= weather.temp %>&#8451 </div>
                <div class="weather-item"> <i class="fa-solid fa-smog"></i> Humidity : <%= weather.humidity %>% </div>
                <div class="weather-item"> <i class="fa-solid fa-smog"></i> Pressure : <%= weather.pressure %> hPa</div>
                <div class="weather-item"> <i class="fa-solid fa-wind"></i> Wind: <%= weather.wind %> m/s</div>
              <% } else { %>
                <div class="weather-item">Weather data not available</div>
              <% } %> 
            </div>
          
             
        </div>
      </div>

      <div class="sub-sec2-3">

        <div class="sub-sec2-3cover">
          <h2> <i class="fa-solid fa-database"></i> Sensor Data :</h2>
        <div class="sub-sec2-3x1">
          <div class="sensorDatalist">
             <ul>
              <li> Panel Temperature : <%= allData[allData.length - 1].sensors.temperature %></li>
              <li> Altitude : <%= allData[allData.length - 1].sensors.altitude %></li>
              <li> Current : <%= allData[allData.length - 1].sensors.current %></li>
              <li> Power : <%= allData[allData.length - 1].sensors.power %></li>
              <li> Light intensity : <%= allData[allData.length - 1].sensors.light_intensity %></li>
              <li> Dust density : <%= allData[allData.length - 1].sensors.dust_density %></li>
              <li> Tilt angle : <%= allData[allData.length - 1].sensors.tilt_angle %></li>
              <li> Ideal power : <%= allData[allData.length - 1].ai_output.ideal_power %></li>
              <li> Efficiency drop : <%= allData[allData.length - 1].ai_output.efficiency_drop %></li>
             </ul>
          </div>
        </div>
        </div>
        <div class="sub-sec2-3x2">
          <h2> <i class="fa-solid fa-triangle-exclamation"></i> Alerts & Forecast :</h2>
          <% 
          const majorFactor = allData[allData.length - 1].root_cause_analysis.major_factor; 
          const contributingFactors = allData[allData.length - 1].root_cause_analysis.contributing_factors; 
          const recommondations = allData[allData.length - 1].root_cause_analysis.recommendation; 
          const next_24_hrs = allData[allData.length - 1].forecast.next_24_hours; 
          const week_trends = allData[allData.length - 1].forecast.week_trend; 
          %>
          <div class="alert1">
            <ul>
              <li><b> Major Factor :</b> <%= majorFactor %> </li>
              <% if (contributingFactors && contributingFactors.length > 0) { %>
                 <li> <b>Contributing Factors :</b> <%= contributingFactors.join(', ') %> </li>
              <% } else { %> 
                 <li><b> Contributing Factors :</b> None </li>
              <% } %>
              <li><b> Recommendations :</b> <%= recommondations %> </li>
            </ul>
          </div>
          <div class="alert2">
            <ul>
              <li><b> Next 24 Hrs prediction :</b> <%= next_24_hrs %> </li>
              <li><b> Week Trends :</b> <%= week_trends %> </li>
            </ul>
          </div>
        </div>
      </div>

      <div class="sub-sec2-2">
        
        <div class="sub-sec2-2x"> 
          <!-- /////////////  Bus Voltage Graph code logic   ////////////// -->
           <div class="busVoltagetitle">
             <p> <i class="fa-solid fa-chart-line"></i> Bus Voltage Chart (Last 20 Records)</p>
          </div> 

          <div class="busVoltageChart">
            <canvas id="busVoltageChart"></canvas>
          </div>

          <script>
            async function loadSolarData() {
            const res = await fetch("/api/solar"); 
            const data = await res.json();

            const N = 20;
            const recent = data.slice(-N).reverse();

            const labels = recent.map(d => 
                new Date(d.timestamp).toLocaleTimeString()
            );

            const voltage = recent.map(d => d.sensors.bus_voltage);

            new Chart(document.getElementById("busVoltageChart"), {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: "Bus Voltage (V)",
                        data: voltage,
                        borderWidth: 2,
                        borderColor: "#0d4e87",
                        backgroundColor: "rgba(30,136,229,0.15)",
                        tension: 0.3,
                        fill: true
                    }]
                },
                options: {
                        responsive: true,
                        maintainAspectRatio: false 
                }
            });
        }

        loadSolarData();
        </script>
        </div>
        <!-- ////////////////////////////////////////////////////////// -->
         <div class="sub-sec2-2x2">

          <div class="shuntVoltagetitle">
            <p><i class="fa-solid fa-chart-column"></i> Shunt Voltage Chart (Last 20 Records)<p>
          </div>

          <div class="shuntVoltageChart">
            <canvas id="shuntVoltageChart"></canvas>
          </div>
          
          <script>
            async function loadSolarData2() {
            const res = await fetch("/api/solar"); 
            const data = await res.json();

            const N = 20;
            const recent = data.slice(-N).reverse();

            const labels = recent.map(d => 
                new Date(d.timestamp).toLocaleTimeString()
            );

            const sh_voltage = recent.map(d => d.sensors.shunt_voltage);

            new Chart(document.getElementById("shuntVoltageChart"), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                         label: "Shunt Voltage (V)",
                         data: sh_voltage,

                         backgroundColor: "rgba(15, 95, 244, 0.6)",
                         borderColor: "#0f5ff4",
                         borderWidth: 1,

                         borderRadius: 6,     // rounded bars
                         barPercentage: 0.7,  // bar width
                         categoryPercentage: 0.8

                    }]
                },
                options: {
                        responsive: true,
                        maintainAspectRatio: false 
                        
                }
            });
        }

        loadSolarData2();
        </script>
         </div>
         
      </div>
      <div class="graphbtndiv">
        <div class="one">
      <form method="GET" action="/graphs">
      <button class="cssbuttons-io">
  <span
    ><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path d="M0 0h24v24H0z" fill="none"></path>
      <i class="fa-solid fa-chart-column"></i>
    </svg>
      &ensp;See More Graphs</span
  >
</button>
    </form>
    </div>
    </div>
    </div>
  </div>
</body>

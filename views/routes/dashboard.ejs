<% layout("/layouts/boilerplate") %>
<body>
  <div class="dashContainer">
    <div class="sec1">

      <div class="sub-sec1x">
        <h3>Last Updated  </h3>
  <% 
    // 1. Get the last item safely
    const lastEntry = allData[allData.length - 1]; 
    
    // 2. Convert to string (handling potential Date objects)
    const rawTimestamp = lastEntry.timestamp.toISOString ? lastEntry.timestamp.toISOString() : String(lastEntry.timestamp);

    // 3. Now split will work
    const [date, fullTime] = rawTimestamp.split('T');
    const time = fullTime.replace('Z', '');
  %>
  <h5>Date : <%= date %> </h5>
  <h5>Time : <%= time %></h5>
</div>

      <div class="sub-sec1">
        <h4 class="efficiencytext"> Efficiency Tracker</h4>
        <% 
          const efficiencyValue = allData[allData.length - 1].ai_output.predicted_efficiency; 
          const filledAngle = (efficiencyValue / 100) * 360; 
        %>
        <div class="efficiency-container">
            <span class="efficiency-value"><%= efficiencyValue %>%</span>
            <div class="progress-circle" 
                 style="--filled-angle: <%= filledAngle %>deg;">
            </div>
        </div>
      </div>

      <div class="sub-sec1">
        <h4 class="healthtext"> Panel Health Indicator</h4>
        <% 
          const healthValue = allData[allData.length - 1].ai_output.panel_health_score; 
          const healthfilledAngle = (healthValue / 100) * 360; 
        %>
        <div class="health-container">
            <span class="health-value"><%= healthValue %>%</span>
            <div class="progress-circle-health" 
                 style="--filled-angle: <%= healthfilledAngle %>deg;">
            </div>
        </div>
      </div>

      <div class="sub-sec1">
        <% 
          const statusString = allData[allData.length - 1].ai_output.status; 
        %>
        <h4 class="status">Panel status: <%= statusString %></h4>
         <div class="solar-panel-container">
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
           <div class="solar-cell-unit"></div>
         </div>
       </div>
    </div>
    <div class="sec2">
      <p class="dashIntro">Welcome to Dashboard <i class="fa-solid fa-chart-simple"></i></p>
      <div class="sub-sec2-1">
        <div class="sub-sec2-1x1 power">
          <% 
          const powerGenerated = allData[allData.length - 1].ai_output.ideal_power; 
          %>
          <h4 class="powerGeneratedtitle">Power Generation By Solar Panel: </h4>
          <h1 class="powerGeneratedvalue"><%= powerGenerated %> KW</h1 class="powerGeneratedvalue">
            
         </div>
        <div class="sub-sec2-1x1 chip">
            <div class="main-container">

          fill="url(#pinGradient)"
          rx="2"
        ></rect>
        <rect
          x="470"
          y="225"
          width="8"
          height="10"
          fill="url(#pinGradient)"
          rx="2"
        ></rect>
        <rect
          x="470"
          y="245"
          width="8"
          height="10"
          fill="url(#pinGradient)"
          rx="2"
        ></rect>
        <rect
          x="470"
          y="265"
          width="8"
